# Copie para .env e ajuste. Não commite o arquivo .env.

# Chrome aberto com: --remote-debugging-port=9223
CHROME_DEBUG_ADDRESS=127.0.0.1:9223

# Caminho do ChromeDriver (deixe vazio se estiver no PATH)
# Linux:   /usr/local/bin/chromedriver
# Windows: C:/caminho/para/chromedriver.exe
CHROMEDRIVER_PATH=

# Pasta dos JSONs coletados / lidos pela análise
DATA_DIR=./data/json

BASE_URL=https://contratos.sistema.gov.br
